+// Sync the user's role from an OIDC claim on every login
+const OAUTH_ROLE_CLAIM = process.env.OAUTH_ROLE_CLAIM;
+// Roles for accounts that don't exist yet, applied once the account is created
+const pendingOAuthRoles = new Map<string, "admin" | "user">();
+
+async function syncOAuthRole(profile: Record<string, unknown>) {
+  if (!OAUTH_ROLE_CLAIM || getReadOnlyModeError(serverConfig)) {
+    return;
+  }
+  const subject = String(profile.sub ?? profile.id ?? "");
+  const roles = profile[OAUTH_ROLE_CLAIM];
+  const role =
+    Array.isArray(roles) && roles.includes("admin") ? "admin" : "user";
+  const linkedUser = db
+    .select({ id: accounts.userId })
+    .from(accounts)
+    .where(
+      and(
+        eq(accounts.providerId, CUSTOM_OAUTH_PROVIDER_ID),
+        eq(accounts.accountId, subject),
+      ),
+    );
+  const updated = await db
+    .update(users)
+    .set({ role })
+    .where(inArray(users.id, linkedUser))
+    .returning({ id: users.id });
+  if (updated.length === 0) {
+    pendingOAuthRoles.set(subject, role);
+  }
+}
